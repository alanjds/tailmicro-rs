//! Tailscale control plane client.
//!
//! Handles:
//! 1. TLS connection to `login.tailscale.com` (or custom host).
//! 2. `HTTP/1.1 Upgrade → ts2021` handshake.
//! 3. Noise IK handshake over the upgraded connection.
//! 4. `RegisterRequest` / `RegisterResponse` (node registration).
//! 5. Long-poll `MapRequest` / streaming `MapResponse` over H/2 frames.
//!
//! ## Memory strategy
//!
//! The `MapResponse` JSON is parsed **incrementally** as H/2 DATA frames
//! arrive.  The maximum heap required at any time is one frame buffer
//! (`tm_h2::MAX_FRAME_SIZE` = 4 KB) plus the JSON parser state (~512 bytes).
//! Peers are written into a caller-supplied `ArrayVec`; we never accumulate
//! the full JSON in memory.
//!
//! ## TLS fingerprint verification (from MicroLink)
//!
//! Rather than bundling the full Mozilla root CA set (~200 KB), we verify the
//! server certificate by its SHA-256 fingerprint.  The fingerprint for
//! `login.tailscale.com` is compiled in and can be overridden via `Config`.

use arrayvec::ArrayVec;
use serde::{Deserialize, Serialize};
use tm_h2::{
    FrameAction, FrameHeader, H2Error, H2State,
    CLIENT_PREFACE, MAX_FRAME_SIZE,
    write_settings, write_settings_ack, write_window_update,
    write_ping_ack, write_map_request_headers,
};
use tm_keys::{MachinePrivateKey, NodePublicKey, NodeState};

// ── Public types (mirrors ts_control::Node / PeerInfo) ───────────────────────

/// Tailnet address of a peer.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct TailnetIp(pub [u8; 4]);

impl TailnetIp {
    pub fn to_ipv4(&self) -> core::net::Ipv4Addr {
        core::net::Ipv4Addr::from(self.0)
    }
}

/// Minimal peer information extracted from MapResponse.
/// ~64 bytes per peer — 8 peers = 512 bytes total.
#[derive(Clone, Debug)]
pub struct PeerInfo {
    pub node_key:    [u8; 32],
    pub disco_key:   [u8; 32],
    pub tailnet_ip:  TailnetIp,
    /// WireGuard allowed IP prefix length (almost always 32).
    pub prefix_len:  u8,
    pub hostname:    heapless::String<64>,
    /// Best DERP region index for this peer.
    pub derp_region: u16,
    pub is_online:   bool,
}

/// A DERP relay region.
#[derive(Clone, Debug)]
pub struct DerpRegion {
    pub region_id:   u16,
    pub region_code: heapless::String<8>,  // e.g. "nyc", "sfo"
    pub host:        heapless::String<64>,
    pub port:        u16,
    pub latency_ms:  u16,  // filled in by tm_netcheck
}

/// The parsed result of one MapResponse.
/// `MAX_PEERS` is a compile-time constant — set to 8 for ESP32-C3.
pub struct MapState<const MAX_PEERS: usize = 8, const MAX_REGIONS: usize = 4> {
    pub our_ip:       TailnetIp,
    pub peers:        ArrayVec<PeerInfo, MAX_PEERS>,
    pub derp_regions: ArrayVec<DerpRegion, MAX_REGIONS>,
}

// ── Config ────────────────────────────────────────────────────────────────────

/// Known SHA-256 fingerprints of `login.tailscale.com` leaf certificates.
/// Update when Tailscale rotates their cert (~annual).
/// MicroLink pattern: compile-in the fingerprint, skip the full cert bundle.
pub const TAILSCALE_CONTROL_FINGERPRINTS: &[[u8; 32]] = &[
    // Current as of early 2025 — verify with:
    //   openssl s_client -connect login.tailscale.com:443 </dev/null 2>/dev/null \
    //     | openssl x509 -noout -fingerprint -sha256
    [
        0xAB, 0xCD, 0xEF, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    ],
    // Add additional fingerprints here for cert rotation without firmware update
];

pub struct Config {
    pub control_host:    &'static str,
    pub control_port:    u16,
    /// If None, certificate verification falls back to the bundle (if available).
    /// On ESP32-C3 with no bundle, fingerprint MUST be set.
    pub cert_fingerprints: &'static [[u8; 32]],
}

impl Default for Config {
    fn default() -> Self {
        Self {
            control_host:      "login.tailscale.com",
            control_port:      443,
            cert_fingerprints: TAILSCALE_CONTROL_FINGERPRINTS,
        }
    }
}

// ── Error ─────────────────────────────────────────────────────────────────────

#[derive(Debug)]
pub enum ControlError {
    Tls,
    Noise(NoiseError),
    Http(httparse::Error),
    H2(H2Error),
    Json(JsonError),
    PeerTableFull,
    RegistrationFailed,
    Io,
}

#[derive(Debug)]
pub enum NoiseError { Handshake, Decrypt, Encrypt }

#[derive(Debug)]
pub enum JsonError { InvalidUtf8, ParseError, MissingField }

impl From<H2Error> for ControlError {
    fn from(e: H2Error) -> Self { ControlError::H2(e) }
}

// ── MapResponse streaming JSON parser ────────────────────────────────────────
//
// We use a hand-rolled state machine rather than serde_json's DOM because:
//   1. serde_json DOM (`Value`) allocates 2-3× the JSON size on the heap.
//   2. serde_json's `from_reader` + `StreamDeserializer` still buffers
//      the entire input before yielding the root object.
//   3. Our JSON structure is known and shallow enough for a simple
//      key-path scanner.
//
// The parser is a byte-at-a-time state machine.  It accumulates only the
// fields we care about (Node.Addresses, Peers[*].Key / AllowedIPs / DERP /
// Hostinfo.Hostname, DERPMap.Regions).
//
// Estimated state size: ~512 bytes (string accumulators on the stack).

#[derive(Debug, Clone, Copy, PartialEq)]
enum ParseState {
    Root,
    // Top-level fields
    InNode,
    InPeers,
    InDerpMap,
    // Peer sub-fields
    InOnePeer,
    // String value accumulation
    AccumulatingString,
    // Skip a value (object, array, or primitive) we don't care about
    SkipValue { depth: u8 },
}

/// Incremental MapResponse parser.
///
/// Feed it bytes with [`MapParser::feed`].  As peers and regions become
/// fully parsed they are pushed into the caller-supplied `MapState`.
pub struct MapParser<const MAX_PEERS: usize = 8, const MAX_REGIONS: usize = 4> {
    state:        ParseState,
    // Scratch buffers — stack allocated, fixed capacity
    key_buf:      heapless::Vec<u8, 64>,
    val_buf:      heapless::Vec<u8, 128>,
    // Peer being assembled
    current_peer: Option<PeerInfo>,
    // Region being assembled
    current_region: Option<DerpRegion>,
    // Track JSON nesting depth for skipping
    skip_depth:   u8,
    // Output
    pub map: MapState<MAX_PEERS, MAX_REGIONS>,
}

impl<const MAX_PEERS: usize, const MAX_REGIONS: usize> MapParser<MAX_PEERS, MAX_REGIONS> {
    pub fn new() -> Self {
        Self {
            state: ParseState::Root,
            key_buf:         heapless::Vec::new(),
            val_buf:         heapless::Vec::new(),
            current_peer:    None,
            current_region:  None,
            skip_depth:      0,
            map: MapState {
                our_ip:       TailnetIp([0; 4]),
                peers:        ArrayVec::new(),
                derp_regions: ArrayVec::new(),
            },
        }
    }

    /// Feed a chunk of bytes (a single H/2 DATA frame payload).
    /// Returns `Ok(true)` when the root JSON object has been closed —
    /// the MapResponse is complete.
    pub fn feed(&mut self, chunk: &[u8]) -> Result<bool, JsonError> {
        for &b in chunk {
            if self.step(b)? {
                return Ok(true);
            }
        }
        Ok(false)
    }

    /// Process one byte.  Returns true when parsing is complete.
    fn step(&mut self, b: u8) -> Result<bool, JsonError> {
        // This is intentionally minimal — a production implementation would
        // handle escape sequences, UTF-16 surrogates, etc.  For the
        // Tailscale MapResponse the values we care about are all ASCII.
        match self.state {
            ParseState::Root => {
                // Looking for top-level keys
                if b == b'"' {
                    self.key_buf.clear();
                    self.state = ParseState::AccumulatingString;
                } else if b == b'}' {
                    return Ok(true); // root object closed
                }
            }
            ParseState::AccumulatingString => {
                if b == b'"' {
                    self.dispatch_key()?;
                } else {
                    self.key_buf.push(b).map_err(|_| JsonError::ParseError)?;
                }
            }
            ParseState::SkipValue { depth } => {
                match b {
                    b'{' | b'[' => self.skip_depth += 1,
                    b'}' | b']' => {
                        if self.skip_depth == 0 {
                            self.state = ParseState::Root;
                        } else {
                            self.skip_depth -= 1;
                        }
                    }
                    b',' if self.skip_depth == 0 => {
                        self.state = ParseState::Root;
                    }
                    _ => {}
                }
            }
            _ => {
                // Delegate to sub-parsers (stub — full impl in Phase 2)
            }
        }
        Ok(false)
    }

    fn dispatch_key(&mut self) -> Result<(), JsonError> {
        match self.key_buf.as_slice() {
            b"Node"    => self.state = ParseState::InNode,
            b"Peers"   => self.state = ParseState::InPeers,
            b"DERPMap" => self.state = ParseState::InDerpMap,
            _          => self.state = ParseState::SkipValue { depth: 0 },
        }
        self.key_buf.clear();
        Ok(())
    }

    /// Finalise — commit any in-progress peer or region.
    pub fn finish(&mut self) {
        if let Some(peer) = self.current_peer.take() {
            let _ = self.map.peers.try_push(peer);
        }
        if let Some(region) = self.current_region.take() {
            let _ = self.map.derp_regions.try_push(region);
        }
    }
}

// ── Control actor message types ───────────────────────────────────────────────
//
// These mirror ts_runtime's message-bus approach but are simpler:
// one channel in, one channel out.

/// Commands sent TO the ControlActor.
pub enum ControlCmd {
    Start { auth_key: heapless::String<128> },
    /// Force re-registration (e.g. key expiry detected).
    Reauth,
    Shutdown,
}

/// Events emitted BY the ControlActor.
pub enum ControlEvent {
    /// A fresh map was parsed — update WireGuard and DERP state.
    MapUpdate(MapState),
    /// Our tailnet IP is now known.
    OurIpAssigned(TailnetIp),
    /// Key expiry detected — caller should trigger Reauth.
    KeyExpiry,
    /// Unrecoverable error.
    Error(ControlError),
}

// ── ControlActor ─────────────────────────────────────────────────────────────
//
// Runs as a single Tokio task.
// Uses tokio::sync::mpsc for inbound commands and outbound events.
// Never spawns sub-tasks — all I/O is cooperative within this task.

pub struct ControlActor {
    config:    Config,
    node_state: NodeState,
}

impl ControlActor {
    pub fn new(config: Config, node_state: NodeState) -> Self {
        Self { config, node_state }
    }

    /// Entry point.  Run inside `tokio::spawn` or `tokio::join!`.
    pub async fn run(
        self,
        mut cmds:   tokio::sync::mpsc::Receiver<ControlCmd>,
        events:     tokio::sync::mpsc::Sender<ControlEvent>,
    ) {
        loop {
            match cmds.recv().await {
                Some(ControlCmd::Start { auth_key }) => {
                    if let Err(e) = self.connect_and_poll(&auth_key, &events).await {
                        let _ = events.send(ControlEvent::Error(e)).await;
                    }
                }
                Some(ControlCmd::Shutdown) | None => break,
                Some(ControlCmd::Reauth) => { /* re-enter connect_and_poll */ }
            }
        }
    }

    async fn connect_and_poll(
        &self,
        auth_key: &str,
        events:   &tokio::sync::mpsc::Sender<ControlEvent>,
    ) -> Result<(), ControlError> {
        // Phase 1: TLS + HTTP/1.1 Upgrade → ts2021
        // (Platform-specific TLS is injected via the IoStream trait below)
        //
        // On ESP32-C3: use esp-idf-svc::tls::EspTls
        // On host:     use tokio-native-tls or rustls
        //
        // Phase 2: Noise IK
        // Phase 3: RegisterRequest
        // Phase 4: MapRequest → streaming MapResponse
        //
        // Stub — full implementation in next commit.
        Ok(())
    }

    /// Read one H/2 DATA frame at a time, feeding bytes to the JSON parser.
    ///
    /// This is the core of the streaming strategy:
    /// - `frame_buf` is 4 KB on the stack — never on the heap.
    /// - `MapParser` state is ~512 bytes on the stack.
    /// - Total overhead: ~4.5 KB regardless of MapResponse size.
    async fn read_map_response<S: IoStream>(
        stream:  &mut S,
        h2:      &mut H2State,
        events:  &tokio::sync::mpsc::Sender<ControlEvent>,
    ) -> Result<(), ControlError> {
        let mut frame_buf = [0u8; MAX_FRAME_SIZE as usize + 9]; // frame header + body
        let mut parser: MapParser = MapParser::new();

        loop {
            // Read 9-byte frame header
            stream.read_exact(&mut frame_buf[..9]).await.map_err(|_| ControlError::Io)?;
            let hdr_bytes: &[u8; 9] = frame_buf[..9].try_into().unwrap();
            let hdr = FrameHeader::from_bytes(hdr_bytes);

            if hdr.length > MAX_FRAME_SIZE {
                return Err(ControlError::H2(H2Error::FrameTooLarge(hdr.length)));
            }

            // Read frame body into the same buffer (after the header)
            let body_len = hdr.length as usize;
            stream.read_exact(&mut frame_buf[9..9 + body_len]).await
                .map_err(|_| ControlError::Io)?;
            let body = &frame_buf[9..9 + body_len];

            match tm_h2::parse_frame(&hdr, body, h2)? {
                FrameAction::Data { payload, end_stream } => {
                    // Feed chunk to streaming JSON parser — no buffering
                    let done = parser.feed(payload)
                        .map_err(ControlError::Json)?;

                    // Send WINDOW_UPDATE if needed (from MicroLink: proactive updates
                    // prevent stalls on slow connections)
                    let (conn_wu, stream_wu) = h2.consumed(payload.len() as u32);
                    if conn_wu > 0 {
                        let mut wu = [0u8; 13];
                        write_window_update(&mut wu, 0, conn_wu);
                        stream.write_all(&wu).await.map_err(|_| ControlError::Io)?;
                    }
                    if stream_wu > 0 {
                        let mut wu = [0u8; 13];
                        write_window_update(&mut wu, 1, stream_wu);
                        stream.write_all(&wu).await.map_err(|_| ControlError::Io)?;
                    }

                    if done || end_stream {
                        parser.finish();
                        let _ = events.send(ControlEvent::MapUpdate(parser.map)).await;
                        return Ok(());
                    }
                }
                FrameAction::SendSettingsAck => {
                    let mut ack = [0u8; 9];
                    write_settings_ack(&mut ack);
                    stream.write_all(&ack).await.map_err(|_| ControlError::Io)?;
                }
                FrameAction::SendPingAck(payload) => {
                    let mut ping_ack = [0u8; 17];
                    write_ping_ack(&mut ping_ack, &payload);
                    stream.write_all(&ping_ack).await.map_err(|_| ControlError::Io)?;
                }
                FrameAction::GoAway => {
                    return Err(ControlError::H2(H2Error::GoAway {
                        last_stream: 0, error_code: 0,
                    }));
                }
                FrameAction::Ignore => {}
            }
        }
    }
}

// ── IoStream trait — platform abstraction ─────────────────────────────────────
//
// Allows the ControlActor to be tested on the host (using tokio TcpStream)
// and deployed on ESP32-C3 (using esp-idf-svc EspTls) without code changes.

pub trait IoStream: Send {
    fn read_exact<'a>(&'a mut self, buf: &'a mut [u8])
        -> impl core::future::Future<Output = Result<(), ()>> + 'a;
    fn write_all<'a>(&'a mut self, buf: &'a [u8])
        -> impl core::future::Future<Output = Result<(), ()>> + 'a;
}

/// Blanket impl for tokio AsyncRead + AsyncWrite (host testing)
#[cfg(feature = "tokio-io")]
impl<T: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send> IoStream for T {
    async fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), ()> {
        tokio::io::AsyncReadExt::read_exact(self, buf).await.map(|_| ()).map_err(|_| ())
    }
    async fn write_all(&mut self, buf: &[u8]) -> Result<(), ()> {
        tokio::io::AsyncWriteExt::write_all(self, buf).await.map_err(|_| ())
    }
}
